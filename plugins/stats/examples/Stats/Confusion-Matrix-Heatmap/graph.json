    { "id": "t_q", "source": "split", "target": "tree", "sourceHandle": "x_test", "targetHandle": "x_query" },
    { "id": "m_p", "source": "tree", "target": "cm", "sourceHandle": "predictions", "targetHandle": "predictions" },
