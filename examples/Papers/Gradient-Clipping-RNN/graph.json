      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Both training-loss curves on one chart: (epoch, loss) points, one\n    # label per run.\n    points, labels = [], []\n    for name, losses in ((\"no clipping\", inputs[\"in1\"]), (\"clip at 1.0\", inputs[\"in2\"])):\n        for epoch, value in enumerate(losses.tolist(), start=1):\n            points.append([epoch, value])\n            labels.append(name)\n    return {\"out1\": torch.tensor(points), \"out2\": labels}\n",
          "input_ports": 2,
          "output_ports": 2,
          "input_types": "TENSOR,TENSOR",
          "output_types": "TENSOR,LIST"
        }
      }
    },
