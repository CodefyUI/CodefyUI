    {
      "id": "grid",
      "type": "PythonScript",
      "position": {
        "x": 1960,
        "y": -40
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Row 1: eight test digits. Row 2: the autoencoder's reconstructions.\n    # Row 3: PCA's. Each from only 2 numbers.\n    # One picture, 3 rows of 8 digits: [3 * 28, 8 * 28].\n    rows = []\n    for images in (inputs[\"in1\"], inputs[\"in2\"], inputs[\"in3\"]):\n        digits = images[:8].clamp(0, 1).reshape(8, 28, 28)\n        rows.append(torch.cat(list(digits), dim=1))\n    return {\"out1\": torch.cat(rows, dim=0)}\n",
          "input_ports": 3,
          "output_ports": 1,
          "input_types": "TENSOR,TENSOR,TENSOR",
          "output_types": "TENSOR"
        }
      }
    },
