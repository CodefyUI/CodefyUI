    {
      "id": "flat-train",
      "type": "PythonScript",
      "position": {
        "x": 680,
        "y": -300
      },
      "data": {
        "params": {
          "code": "def run(inputs, params):\n    images = inputs[\"in1\"]\n    # Dataset's default transform maps pixels to [-1, 1]. The decoder ends\n    # in a Sigmoid, so map back to [0, 1], then flatten 28x28 to 784.\n    x = (images * 0.5 + 0.5).reshape(images.shape[0], -1)\n    return {\"out1\": x}\n",
          "input_ports": 1,
          "output_ports": 1,
          "input_types": "TENSOR",
          "output_types": "TENSOR"
        }
      }
    },
