    {
      "id": "encode",
      "type": "PythonScript",
      "position": {
        "x": 1640,
        "y": 420
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef knn_accuracy(codes, labels, k=5):\n    # Leave-one-out k-nearest-neighbour accuracy in the code space: how\n    # often a digit's 5 nearest codes mostly carry its own label.\n    d = torch.cdist(codes, codes)\n    d.fill_diagonal_(float(\"inf\"))\n    nearest = d.topk(k, largest=False).indices\n    vote = torch.mode(labels[nearest], dim=1).values\n    return float((vote == labels).float().mean())\n\n\ndef run(inputs, params):\n    model, x, labels = inputs[\"in1\"], inputs[\"in2\"], inputs[\"in3\"]\n    # The encoder half of the trained model: layers l0..l2 of the layer\n    # editor (Linear 784->256, ReLU, Linear 256->2).\n    h = x\n    with torch.no_grad():\n        for name in [\"l0\", \"l1\", \"l2\"]:\n            h = model.layers[name](h)\n    return {\"out1\": h, \"out2\": [int(v) for v in labels.tolist()],\n            \"out3\": knn_accuracy(h, labels)}\n",
          "input_ports": 3,
          "output_ports": 3,
          "input_types": "MODEL,TENSOR,TENSOR",
          "output_types": "TENSOR,LIST,SCALAR"
        }
      }
    },
    {
      "id": "pca",
      "type": "PythonScript",
      "position": {
        "x": 1320,
        "y": 900
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef knn_accuracy(codes, labels, k=5):\n    # Leave-one-out k-nearest-neighbour accuracy in the code space: how\n    # often a digit's 5 nearest codes mostly carry its own label.\n    d = torch.cdist(codes, codes)\n    d.fill_diagonal_(float(\"inf\"))\n    nearest = d.topk(k, largest=False).indices\n    vote = torch.mode(labels[nearest], dim=1).values\n    return float((vote == labels).float().mean())\n\n\ndef run(inputs, params):\n    x_train, x_test, labels = inputs[\"in1\"], inputs[\"in2\"], inputs[\"in3\"]\n    # PCA, the linear method the paper compares against: the 2 directions\n    # of largest variance in the training images.\n    mean = x_train.mean(dim=0)\n    centred = x_train - mean\n    u, _, _ = torch.svd(centred.T @ centred)  # eigenvectors of the covariance\n    basis = u[:, :2]\n    codes = (x_test - mean) @ basis\n    recon = codes @ basis.T + mean\n    return {\"out1\": codes, \"out2\": [int(v) for v in labels.tolist()],\n            \"out3\": recon, \"out4\": knn_accuracy(codes, labels)}\n",
          "input_ports": 3,
          "output_ports": 4,
          "input_types": "TENSOR,TENSOR,TENSOR",
          "output_types": "TENSOR,LIST,TENSOR,SCALAR"
        }
      }
    },
