        "params": {
          "code": "def run(inputs, params):\n    pred, truth, x = inputs[\"in1\"], inputs[\"in2\"], inputs[\"in3\"]\n    for i in range(3):\n        print(\"input \", x[i].tolist())\n        print(\"output\", pred[i].tolist())\n    token_acc = float((pred == truth).float().mean())\n    exact = float((pred == truth).all(dim=1).float().mean())\n    return {\"out1\": exact, \"out2\": token_acc}\n",
