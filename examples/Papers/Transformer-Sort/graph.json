      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Sequences of 10 digits (0-9) and the same digits in sorted order.\n    g = torch.Generator().manual_seed(0)\n    def make(n):\n        x = torch.randint(0, 10, (n, 10), generator=g)\n        return x, torch.sort(x, dim=1).values\n    x_train, y_train = make(5000)\n    x_test, y_test = make(1000)  # fresh sequences the model never saw\n    return {\"out1\": Pairs(x_train, y_train), \"out2\": x_test, \"out3\": y_test}\n\n\nclass Pairs:\n    \"\"\"(sequence, sorted sequence) pairs, both int64 token ids [10].\n\n    A dataset is anything with __len__ and __getitem__, so DataLoader takes\n    this directly. TensorDataset would turn the [N, 10] targets into float\n    numbers or flatten them as class labels, and the loss needs integer ids.\n    \"\"\"\n\n    def __init__(self, x, y):\n        self.x, self.y = x, y\n\n    def __len__(self):\n        return len(self.x)\n\n    def __getitem__(self, i):\n        return self.x[i], self.y[i]\n",
          "input_ports": 1,
          "output_ports": 3,
          "input_types": "TENSOR",
          "output_types": "DATASET,TENSOR,TENSOR"
        }
      }
    },
