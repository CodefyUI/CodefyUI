    {
      "id": "gen",
      "type": "PythonScript",
      "position": {
        "x": -93,
        "y": -300
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # 2000 steps of a two-sine wave plus Gaussian noise (std 0.15),\n    # cut into windows of 30 values, each labelled with the value after it.\n    g = torch.Generator().manual_seed(0)\n    t = torch.arange(2000, dtype=torch.float32)\n    series = (torch.sin(2 * 3.14159 * t / 50)\n              + 0.5 * torch.sin(2 * 3.14159 * t / 13)\n              + 0.15 * torch.randn(2000, generator=g))\n    win = 30\n    x = torch.stack([series[i:i + win] for i in range(len(series) - win)])\n    y = series[win:]\n    cut = int(0.7 * len(y))  # train on the first 70% of time, test on the rest\n    x = x.unsqueeze(-1)       # [N, 30, 1]: 30 steps of 1 feature for the LSTM\n    return {\"out1\": x[:cut], \"out2\": y[:cut], \"out3\": x[cut:], \"out4\": y[cut:],\n            \"out5\": x[cut:, -1, 0]}  # persistence baseline: repeat the last value\n",
          "input_ports": 1,
          "output_ports": 5,
          "input_types": "TENSOR",
          "output_types": "TENSOR,TENSOR,TENSOR,TENSOR,TENSOR"
        }
      }
    },
