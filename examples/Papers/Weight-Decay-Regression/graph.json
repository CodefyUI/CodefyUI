      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # 20 noisy samples of sin(3x) on [-1, 1] to train on, and a dense grid\n    # of 200 points with the clean curve to test against.\n    g = torch.Generator().manual_seed(0)\n    x = torch.rand(20, 1, generator=g) * 2 - 1\n    y = torch.sin(3 * x) + 0.3 * torch.randn(20, 1, generator=g)\n    grid = torch.linspace(-1, 1, 200).unsqueeze(1)\n    return {\"out1\": x, \"out2\": y, \"out3\": grid, \"out4\": torch.sin(3 * grid)}\n",
          "input_ports": 1,
          "output_ports": 4,
          "input_types": "TENSOR",
          "output_types": "TENSOR,TENSOR,TENSOR,TENSOR"
        }
      }
    },
