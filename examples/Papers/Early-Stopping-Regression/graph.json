    {
      "id": "gen",
      "type": "PythonScript",
      "position": {
        "x": -93,
        "y": -300
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # 20 noisy samples of sin(3x) to train on, 20 more to validate on, and a\n    # dense grid of 200 points with the clean curve to test against.\n    g = torch.Generator().manual_seed(0)\n    def draw(n):\n        x = torch.rand(n, 1, generator=g) * 2 - 1\n        return x, torch.sin(3 * x) + 0.3 * torch.randn(n, 1, generator=g)\n    x_train, y_train = draw(20)\n    x_val, y_val = draw(20)\n    grid = torch.linspace(-1, 1, 200).unsqueeze(1)\n    return {\"out1\": x_train, \"out2\": y_train, \"out3\": x_val, \"out4\": y_val,\n            \"out5\": grid, \"out6\": torch.sin(3 * grid)}\n",
          "input_ports": 1,
          "output_ports": 6,
          "input_types": "TENSOR",
          "output_types": "TENSOR,TENSOR,TENSOR,TENSOR,TENSOR,TENSOR"
        }
      }
    },
