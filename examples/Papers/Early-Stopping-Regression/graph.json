    {
      "id": "curves",
      "type": "PythonScript",
      "position": {
        "x": 1364,
        "y": -34
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Validation loss per epoch for both runs, and where the early-stopped\n    # run found its best epoch.\n    points, labels = [], []\n    for name, losses in ((\"trained to epoch 1000\", inputs[\"in1\"]),\n                         (\"early stopping\", inputs[\"in2\"])):\n        for epoch, value in enumerate(losses.tolist(), start=1):\n            points.append([epoch, value])\n            labels.append(name)\n    metrics = inputs[\"in3\"]\n    return {\"out1\": torch.tensor(points), \"out2\": labels,\n            \"out3\": metrics[\"best_epoch\"], \"out4\": metrics[\"total_epochs_run\"]}\n",
          "input_ports": 3,
          "output_ports": 4,
          "input_types": "TENSOR,TENSOR,ANY",
          "output_types": "TENSOR,LIST,SCALAR,SCALAR"
        }
      }
    },
