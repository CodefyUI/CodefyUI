    {
      "id": "dedup",
      "type": "PythonScript",
      "position": {
        "x": 720,
        "y": 624
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Keep the first copy of every repeated row (features and label).\n    x = inputs[\"in1\"]\n    labels = list(inputs[\"in2\"])\n    seen, keep = set(), []\n    for i, row in enumerate(x.tolist()):\n        key = (tuple(row), labels[i])\n        if key not in seen:\n            seen.add(key)\n            keep.append(i)\n    dropped = len(labels) - len(keep)\n    return {\"out1\": x[keep], \"out2\": [labels[i] for i in keep],\n            \"out3\": f\"{len(labels)} rows, {dropped} exact repeat{'' if dropped == 1 else 's'} removed, \"\n                    f\"{len(keep)} left\"}\n",
          "input_ports": 2,
          "output_ports": 3,
          "input_types": "TENSOR,LIST",
          "output_types": "TENSOR,LIST,STRING"
        }
      }
    },
