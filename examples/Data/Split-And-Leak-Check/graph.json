    {
      "id": "leak-before",
      "type": "PythonScript",
      "position": {
        "x": 2097,
        "y": 0
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # How many evaluation rows also appear, value for value, in the training\n    # split. A model can score those by memory alone.\n    train = {tuple(row) for row in inputs[\"in1\"].tolist()}\n    val_hits = sum(tuple(row) in train for row in inputs[\"in2\"].tolist())\n    test_hits = sum(tuple(row) in train for row in inputs[\"in3\"].tolist())\n    return {\"out1\": f\"{val_hits} of {len(inputs['in2'])} validation rows and {test_hits} of \"\n                    f\"{len(inputs['in3'])} test rows also appear in the training split\"}\n",
          "input_ports": 3,
          "output_ports": 1,
          "input_types": "TENSOR,TENSOR,TENSOR",
          "output_types": "STRING"
        }
      }
    },
