    {
      "id": "label",
      "type": "PythonScript",
      "position": {
        "x": 1817,
        "y": 182
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # The class order TensorDataset gave the training labels (sorted names).\n    species = [\"setosa\", \"versicolor\", \"virginica\"]\n    probs = torch.softmax(inputs[\"in1\"][0], dim=0).tolist()\n    best = max(range(3), key=lambda i: probs[i])\n    return {\"out1\": species[best], \"out2\": {s: round(p, 4) for s, p in zip(species, probs)}}\n",
          "input_ports": 1,
          "output_ports": 2,
          "input_types": "TENSOR",
          "output_types": "STRING,ANY"
        }
      }
    },
