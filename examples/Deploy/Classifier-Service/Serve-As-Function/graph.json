      "id": "to-tensor",
      "type": "PythonScript",
      "position": {
        "x": 720,
        "y": 0
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # One flower: [sepal length, sepal width, petal length, petal width] in cm.\n    values = inputs[\"in1\"]\n    if not isinstance(values, list) or len(values) != 4:\n        raise ValueError(\"measurements must be a list of 4 numbers: \"\n                         \"sepal length, sepal width, petal length, petal width (cm)\")\n    return {\"out1\": torch.tensor([values], dtype=torch.float32)}\n",
          "input_ports": 1,
          "output_ports": 1,
          "input_types": "ANY",
          "output_types": "TENSOR"
        }
      }
    },
    {
      "id": "model",
      "type": "SequentialModel",
      "position": {
        "x": 360,
        "y": 364
      },
      "data": {
        "params": {
          "layers": "{\"version\": 2, \"nodes\": [{\"id\": \"in\", \"type\": \"Input\", \"ports\": [{\"id\": \"p_x\", \"name\": \"x\"}]}, {\"id\": \"l0\", \"type\": \"Linear\", \"params\": {\"in_features\": 4, \"out_features\": 16}}, {\"id\": \"r0\", \"type\": \"ReLU\"}, {\"id\": \"l1\", \"type\": \"Linear\", \"params\": {\"in_features\": 16, \"out_features\": 3}}, {\"id\": \"out\", \"type\": \"Output\", \"ports\": [{\"id\": \"p_y\", \"name\": \"y\"}]}], \"edges\": [{\"id\": \"e1\", \"source\": \"in\", \"target\": \"l0\", \"sourceHandle\": \"p_x\"}, {\"id\": \"e2\", \"source\": \"l0\", \"target\": \"r0\"}, {\"id\": \"e3\", \"source\": \"r0\", \"target\": \"l1\"}, {\"id\": \"e4\", \"source\": \"l1\", \"target\": \"out\", \"targetHandle\": \"p_y\"}]}"
        }
      }
    },
