    { "id": "patch_embed", "type": "Conv2d", "position": { "x": 270, "y": 0 }, "data": { "params": { "in_channels": 3, "out_channels": 48, "kernel_size": 4, "stride": 4, "padding": 0 } } },
    { "id": "stage1_flat", "type": "Reshape", "position": { "x": 550, "y": 0 }, "data": { "params": { "shape": "2,48,64" } } },
    { "id": "stage1_seq", "type": "Permute", "position": { "x": 820, "y": 0 }, "data": { "params": { "dims": "2,0,1" } } },
    { "id": "stage1_enc", "type": "TransformerEncoder", "position": { "x": 1140, "y": 0 }, "data": { "params": { "d_model": 48, "nhead": 4, "num_layers": 2, "dim_feedforward": 192 } } },
    { "id": "stage1_bf", "type": "Permute", "position": { "x": 1490, "y": 0 }, "data": { "params": { "dims": "1,2,0" } } },
