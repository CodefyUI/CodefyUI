{
  "name": "ResNet with Skip Connections",
  "description": "The shortcuts are drawn as Add nodes",
  "gallery": { "section": "architectures", "family": "CNN", "order": 1 },
  "nodes": [
    { "id": "start-1", "type": "Start", "position": { "x": -250, "y": 0 }, "data": { "params": {} } },

    { "id": "input", "type": "TensorCreate", "position": { "x": 0, "y": 0 }, "data": { "params": { "shape": "2,3,32,32", "fill": "randn", "value": 0.0, "requires_grad": false } } },

    { "id": "stem_conv", "type": "Conv2d", "position": { "x": 270, "y": 0 }, "data": { "params": { "in_channels": 3, "out_channels": 64, "kernel_size": 7, "stride": 2, "padding": 3 } } },
    { "id": "stem_bn", "type": "BatchNorm2d", "position": { "x": 550, "y": 0 }, "data": { "params": { "num_features": 64 } } },
    { "id": "stem_act", "type": "Activation", "position": { "x": 820, "y": 0 }, "data": { "params": { "function": "relu" } } },
    { "id": "stem_pool", "type": "MaxPool2d", "position": { "x": 1090, "y": 0 }, "data": { "params": { "kernel_size": 3, "stride": 2 } } },

    { "id": "b1_c1", "type": "Conv2d", "position": { "x": 0, "y": 270 }, "data": { "params": { "in_channels": 64, "out_channels": 64, "kernel_size": 3, "stride": 1, "padding": 1 } } },
    { "id": "b1_bn1", "type": "BatchNorm2d", "position": { "x": 270, "y": 270 }, "data": { "params": { "num_features": 64 } } },
    { "id": "b1_act1", "type": "Activation", "position": { "x": 550, "y": 270 }, "data": { "params": { "function": "relu" } } },
    { "id": "b1_c2", "type": "Conv2d", "position": { "x": 820, "y": 270 }, "data": { "params": { "in_channels": 64, "out_channels": 64, "kernel_size": 3, "stride": 1, "padding": 1 } } },
    { "id": "b1_bn2", "type": "BatchNorm2d", "position": { "x": 1090, "y": 270 }, "data": { "params": { "num_features": 64 } } },
    { "id": "b1_add", "type": "Add", "position": { "x": 1360, "y": 140 }, "data": { "params": { "alpha": 1.0 } } },
    { "id": "b1_act2", "type": "Activation", "position": { "x": 1640, "y": 140 }, "data": { "params": { "function": "relu" } } },

    { "id": "b2_c1", "type": "Conv2d", "position": { "x": 0, "y": 550 }, "data": { "params": { "in_channels": 64, "out_channels": 64, "kernel_size": 3, "stride": 1, "padding": 1 } } },
    { "id": "b2_bn1", "type": "BatchNorm2d", "position": { "x": 270, "y": 550 }, "data": { "params": { "num_features": 64 } } },
    { "id": "b2_act1", "type": "Activation", "position": { "x": 550, "y": 550 }, "data": { "params": { "function": "relu" } } },
    { "id": "b2_c2", "type": "Conv2d", "position": { "x": 820, "y": 550 }, "data": { "params": { "in_channels": 64, "out_channels": 64, "kernel_size": 3, "stride": 1, "padding": 1 } } },
    { "id": "b2_bn2", "type": "BatchNorm2d", "position": { "x": 1090, "y": 550 }, "data": { "params": { "num_features": 64 } } },
    { "id": "b2_add", "type": "Add", "position": { "x": 1360, "y": 410 }, "data": { "params": { "alpha": 1.0 } } },
    { "id": "b2_act2", "type": "Activation", "position": { "x": 1640, "y": 410 }, "data": { "params": { "function": "relu" } } },

    { "id": "head_pool", "type": "AdaptiveAvgPool2d", "position": { "x": 1910, "y": 270 }, "data": { "params": { "output_height": 1, "output_width": 1 } } },
    { "id": "head_flat", "type": "Flatten", "position": { "x": 2180, "y": 270 }, "data": { "params": { "start_dim": 1 } } },
    { "id": "head_fc", "type": "Linear", "position": { "x": 2460, "y": 270 }, "data": { "params": { "in_features": 64, "out_features": 10 } } },
    { "id": "print_logits", "type": "Print", "position": { "x": 2730, "y": 270 }, "data": { "params": { "label": "Logits (B,10)" } } },

    { "id": "note-overview", "type": "note", "position": { "x": -670, "y": 0 },
      "data": { "noteKind": "text", "noteContent": "A residual block adds its own input back onto its output, so gradients reach the early layers through the shortcut and not only through the convolutions. That is what let ResNet go deep. The two shortcuts here are the edges into b1_add and b2_add, drawn on the canvas instead of hidden inside a module.\n\nThe input is a random tensor: this graph shows the wiring and the shapes, not a trained model. The Print at the end is (2, 10) - two images, ten classes.\n\n殘差區塊把自己的輸入加回輸出，梯度除了走卷積，也能沿著捷徑回到前面的層，ResNet 才疊得深。這裡兩條捷徑就是接進 b1_add 與 b2_add 的那兩條邊，直接畫在畫布上，而不是藏在模組裡。\n\n輸入是隨機張量：這張圖看的是接線與形狀，不是訓練好的模型。最後的 Print 是 (2, 10)，兩張影像、十個類別。",
                 "noteColor": "#3d3d1a", "boundToNodeId": "start-1", "boundOffset": { "x": -420, "y": 0 }, "noteWidth": 360 } },

    { "id": "note-b1_add", "type": "note", "position": { "x": 1420, "y": -170 },
      "data": { "noteKind": "text", "noteContent": "The shortcut edge comes from stem_pool, the block's input; the other edge is the block's output. alpha is 1.0, so this is a plain sum, and the ReLU after it is applied to the sum - that order is the paper's.\n\n捷徑那條邊來自 stem_pool，也就是這個區塊的輸入；另一條是區塊自己的輸出。alpha 是 1.0，所以這裡就是單純相加，後面的 b1_act2 是對「相加之後」做 ReLU — 這個順序來自論文。",
                 "noteColor": "#3d3d1a", "boundToNodeId": "b1_add", "boundOffset": { "x": 60, "y": -310 }, "noteWidth": 300 } }
  ],
  "edges": [
    { "id": "e-trig-input", "source": "start-1", "target": "input", "sourceHandle": "trigger", "type": "trigger" },

    { "id": "e-input-stemconv", "source": "input", "target": "stem_conv", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-stemconv-stembn", "source": "stem_conv", "target": "stem_bn", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-stembn-stemact", "source": "stem_bn", "target": "stem_act", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-stemact-stempool", "source": "stem_act", "target": "stem_pool", "sourceHandle": "tensor", "targetHandle": "tensor" },

    { "id": "e-stempool-b1c1", "source": "stem_pool", "target": "b1_c1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b1c1-b1bn1", "source": "b1_c1", "target": "b1_bn1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b1bn1-b1act1", "source": "b1_bn1", "target": "b1_act1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b1act1-b1c2", "source": "b1_act1", "target": "b1_c2", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b1c2-b1bn2", "source": "b1_c2", "target": "b1_bn2", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b1bn2-b1add", "source": "b1_bn2", "target": "b1_add", "sourceHandle": "tensor", "targetHandle": "tensor_a" },
    { "id": "e-skip1-b1add", "source": "stem_pool", "target": "b1_add", "sourceHandle": "tensor", "targetHandle": "tensor_b" },
    { "id": "e-b1add-b1act2", "source": "b1_add", "target": "b1_act2", "sourceHandle": "tensor", "targetHandle": "tensor" },

    { "id": "e-b1act2-b2c1", "source": "b1_act2", "target": "b2_c1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b2c1-b2bn1", "source": "b2_c1", "target": "b2_bn1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b2bn1-b2act1", "source": "b2_bn1", "target": "b2_act1", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b2act1-b2c2", "source": "b2_act1", "target": "b2_c2", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b2c2-b2bn2", "source": "b2_c2", "target": "b2_bn2", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-b2bn2-b2add", "source": "b2_bn2", "target": "b2_add", "sourceHandle": "tensor", "targetHandle": "tensor_a" },
    { "id": "e-skip2-b2add", "source": "b1_act2", "target": "b2_add", "sourceHandle": "tensor", "targetHandle": "tensor_b" },
    { "id": "e-b2add-b2act2", "source": "b2_add", "target": "b2_act2", "sourceHandle": "tensor", "targetHandle": "tensor" },

    { "id": "e-b2act2-headpool", "source": "b2_act2", "target": "head_pool", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-headpool-flat", "source": "head_pool", "target": "head_flat", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-flat-fc", "source": "head_flat", "target": "head_fc", "sourceHandle": "tensor", "targetHandle": "tensor" },
    { "id": "e-fc-print", "source": "head_fc", "target": "print_logits", "sourceHandle": "tensor", "targetHandle": "value" }
  ]
}
