{
  "name": "PPO Robotics Controller",
  "description": "Proximal Policy Optimization for Robotics Control - PPO (OpenAI, 2017) is the default algorithm behind most modern RL deployments: OpenAI Five (Dota 2), ChatGPT RLHF fine-tuning, robotic manipulation, and autonomous driving. Uses a clipped surrogate objective for stable policy gradient updates with an Actor-Critic architecture. This example runs fully offline: a TensorCreate node supplies a synthetic batch of Humanoid-style observations (randn, shape 2x376) in place of a live MuJoCo environment, so no gym/mujoco install is needed. Swap in an EnvWrapper to drive it from a real environment.",
  "nodes": [
    {
      "id": "start-1",
      "type": "Start",
      "position": {
        "x": -150,
        "y": 50
      },
      "data": {
        "params": {}
      }
    },
    {
      "id": "obs-1",
      "type": "TensorCreate",
      "position": {
        "x": 50,
        "y": 50
      },
      "data": {
        "params": {
          "shape": "2,376",
          "fill": "randn",
          "value": 0,
          "requires_grad": false
        }
      }
    },
    {
      "id": "print-obs",
      "type": "Print",
      "position": {
        "x": 50,
        "y": 500
      },
      "data": {
        "params": {
          "label": "Synthetic observation batch: 2x376 (joints + velocities + contacts)"
        }
      }
    },
    {
      "id": "ppo-1",
      "type": "PPO",
      "position": {
        "x": 50,
        "y": 300
      },
      "data": {
        "params": {
          "state_dim": 376,
          "action_dim": 17,
          "hidden_dim": 256
        }
      }
    },
    {
      "id": "optimizer-1",
      "type": "Optimizer",
      "position": {
        "x": 400,
        "y": 750
      },
      "data": {
        "params": {
          "type": "AdamW",
          "lr": 0.0003,
          "weight_decay": 0.0
        }
      }
    },
    {
      "id": "print-action",
      "type": "Print",
      "position": {
        "x": 400,
        "y": 500
      },
      "data": {
        "params": {
          "label": "Action probabilities: 17 dims (Actor head output)"
        }
      }
    },
    {
      "id": "visualize-actions",
      "type": "Visualize",
      "position": {
        "x": 750,
        "y": 500
      },
      "data": {
        "params": {
          "title": "Action Probabilities (batch x action)",
          "plot_type": "heatmap"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-1",
      "source": "obs-1",
      "target": "ppo-1",
      "sourceHandle": "tensor",
      "targetHandle": "state"
    },
    {
      "id": "e-2",
      "source": "obs-1",
