      "sourceHandle": "model",
      "targetHandle": "model"
    },
    {
      "id": "e-4",
      "source": "ppo-1",
      "target": "print-action",
      "sourceHandle": "action",
      "targetHandle": "value"
    },
    {
      "id": "e-auto-6",
      "source": "ppo-1",
