    {
      "id": "tasks",
      "type": "PythonScript",
      "position": {
        "x": 1080,
        "y": 0
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Shuffle once. The first 1,000 images, all ten digits, are the big\n    # labelled set to pretrain on. From the rest, the new task takes 2 images\n    # of every digit (20 in all) labelled only \"is it 5 or more?\", and tests\n    # on every image left: none of those is used for training of any kind.\n    x = inputs[\"in1\"]\n    y = torch.tensor([int(v) for v in inputs[\"in2\"]], device=device)\n    g = torch.Generator(device=device).manual_seed(0)\n    order = torch.randperm(len(y), generator=g, device=device)\n    pre, rest = order[:1000], order[1000:]\n    picked = []\n    for digit in range(10):\n        picked += rest[y[rest] == digit][:2].tolist()\n    chosen = set(picked)\n    held_out = [i for i in rest.tolist() if i not in chosen]\n    big = (y >= 5).long()\n    return {\"out1\": x[pre], \"out2\": y[pre], \"out3\": x[picked], \"out4\": big[picked],\n            \"out5\": x[held_out], \"out6\": big[held_out]}\n",
          "input_ports": 2,
          "output_ports": 6,
          "input_types": "TENSOR,LIST",
          "output_types": "TENSOR,TENSOR,TENSOR,TENSOR,TENSOR,TENSOR"
        }
      }
    },
