      "data": {
        "params": {
          "code": "def run(inputs, params):\n    # The pretrained model keeps its backbone weights; the head starts again\n    # from random weights, because it answered \"which of 0-4\" and the new\n    # task is \"which of 5-9\".\n    model = inputs[\"in1\"]\n    model.layers[\"head\"].reset_parameters()\n    return {\"out1\": model}\n",
          "input_ports": 1,
          "output_ports": 1,
          "input_types": "MODEL",
          "output_types": "MODEL"
        }
      }
    },
