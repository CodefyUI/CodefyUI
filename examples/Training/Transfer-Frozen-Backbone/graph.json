    {
      "id": "backbone",
      "type": "PythonScript",
      "position": {
        "x": 3553,
        "y": 312
      },
      "data": {
        "params": {
          "code": "def run(inputs, params):\n    # Copies every pretrained weight except the head into the new model. Its\n    # head answers a different question (2 classes, not 10), so it keeps the\n    # random weights it was built with.\n    pretrained = inputs[\"in1\"]\n    model = inputs[\"in2\"]\n    backbone = {name: value for name, value in pretrained.state_dict().items()\n                if not name.startswith(\"layers.head.\")}\n    model.load_state_dict(backbone, strict=False)\n    return {\"out1\": model}\n",
          "input_ports": 2,
          "output_ports": 1,
          "input_types": "MODEL,MODEL",
          "output_types": "MODEL"
        }
      }
    },
