{
  "name": "RAG with a chat API: retrieve locally, generate anywhere",
  "description": "Needs the sentence-embeddings pack plus a running Ollama, or an API key instead. The same retrieval chain as RAG-Local-Offline (DocumentLoader -> TextChunker -> TextEmbedding -> VectorStore -> Retriever -> PromptBuilder), but the generator is LLMChat: by default it talks to a local Ollama at http://127.0.0.1:11434 running qwen2.5:0.5b ('ollama pull qwen2.5:0.5b' first), and switching provider to ChatGPT API or Claude API with a key sends the identical prompt to a hosted model. Compare its answer with the local example's. README.md beside this graph explains each stage.",
  "nodes": [
    {
      "id": "start",
      "type": "Start",
      "position": {
        "x": -300,
        "y": 200
      },
      "data": {
        "params": {}
      }
    },
    {
      "id": "loader",
      "type": "DocumentLoader",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "params": {
          "source": "directory",
          "directory": "data/samples/rag",
          "recursive": false,
          "file": "",
          "max_docs": 0
        }
      }
    },
    {
      "id": "chunker",
      "type": "TextChunker",
      "position": {
        "x": 300,
        "y": 0
      },
      "data": {
        "params": {
          "strategy": "characters",
          "chunk_size": 400,
          "chunk_overlap": 80,
          "min_chunk_chars": 40
        }
      }
    },
    {
      "id": "embed_docs",
      "type": "TextEmbedding",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "params": {
          "model": "intfloat/multilingual-e5-small",
          "text": "",
          "split_lines": false,
          "prefix": "passage: ",
          "normalize": true,
          "batch_size": 32,
          "max_seq_length": 0,
          "label_chars": 48,
          "device": "auto"
        }
      }
    },
    {
      "id": "store",
      "type": "VectorStore",
      "position": {
        "x": 900,
        "y": 0
      },
      "data": {
        "params": {
          "metric": "cosine",
          "normalize": true
        }
      }
    },
    {
      "id": "question",
      "type": "TextInput",
      "position": {
        "x": 0,
        "y": 400
      },
      "data": {
        "params": {
          "value": "What is a node in CodefyUI, and how do I run a graph?"
        }
      }
    },
    {
      "id": "embed_q",
      "type": "TextEmbedding",
      "position": {
        "x": 600,
        "y": 400
      },
      "data": {
        "params": {
          "model": "intfloat/multilingual-e5-small",
          "text": "",
          "split_lines": false,
          "prefix": "query: ",
          "normalize": true,
          "batch_size": 32,
          "max_seq_length": 0,
          "label_chars": 48,
          "device": "auto"
        }
      }
    },
    {
      "id": "retriever",
      "type": "Retriever",
      "position": {
        "x": 1200,
        "y": 200
      },
      "data": {
        "params": {
          "top_k": 3,
          "min_score": 0.0
        }
      }
    },
    {
      "id": "print_ctx",
      "type": "Print",
      "position": {
        "x": 1500,
        "y": 20
      },
      "data": {
        "params": {
          "label": "Retrieved contexts"
        }
      }
    },
    {
      "id": "prompt",
      "type": "PromptBuilder",
      "position": {
        "x": 1500,
        "y": 400
      },
      "data": {
        "params": {
          "template": "Answer the question using only the context below. If the context does not contain the answer, say you do not know. Answer in the language of the question.\n\nContext:\n{context}\n\nQuestion: {question}\nAnswer:",
          "separator": "blank_line",
          "number_contexts": true,
          "max_context_chars": 0
        }
      }
    },
    {
      "id": "gen",
      "type": "LLMChat",
      "position": {
        "x": 1800,
        "y": 400
      },
      "data": {
        "params": {
          "provider": "Ollama",
          "model": "qwen2.5:0.5b",
          "prompt": "",
          "system_prompt": "You are a helpful assistant. Use only the provided context; if it is not enough, say so. Answer in the language of the question.",
          "ollama_base_url": "http://127.0.0.1:11434/v1",
          "max_tokens": 300,
          "temperature": 0.2
        }
      }
    },
    {
      "id": "print_ans",
      "type": "Print",
      "position": {
        "x": 2100,
        "y": 400
      },
      "data": {
        "params": {
          "label": "Answer"
        }
      }
    }
  ],
