{
  "name": "Sentence Similarity (zh-TW): meaning, not spelling",
  "description": "Needs the sentence-embeddings pack (Package Center); then runs offline on CPU. A multilingual sentence-transformer encodes eight Traditional Chinese sentences: four pairs on weather, food, the stock market and machine learning, the last split across Chinese and English. CosineSimilarity lists the 3 nearest for each: rank 1 is always itself (score 1.0), rank 2 should be its partner though they share almost no characters, and the zh/en pair shows the model aligns languages. EmbeddingScatter projects the vectors to 2D. Switch to BAAI/bge-small-zh-v1.5 for a Chinese-focused encoder.",
  "nodes": [
    { "id": "start",      "type": "Start",            "position": { "x": -260, "y":  60 }, "data": { "params": {} } },
    { "id": "sentences",  "type": "TextInput",        "position": { "x":    0, "y":  60 }, "data": { "params": { "value": "今天天氣很好，我們去公園散步吧。\n天氣晴朗，很適合到戶外走走。\n這家餐廳的牛肉麵非常好吃。\n我推薦這間店的滷肉飯，味道很棒。\n股市今天大幅下跌，投資人很緊張。\n台股收盤重挫，市場情緒低迷。\n機器學習模型需要大量資料來訓練。\nTraining a neural network requires a large dataset." } } },
    { "id": "embed",      "type": "TextEmbedding",    "position": { "x":  300, "y":  60 }, "data": { "params": { "model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2", "text": "", "split_lines": true, "prefix": "", "normalize": true, "batch_size": 32, "max_seq_length": 0, "label_chars": 48, "device": "auto" } } },
    { "id": "similarity", "type": "CosineSimilarity", "position": { "x":  600, "y": -60 }, "data": { "params": { "top_k": 3, "exclude_self_words": "" } } },
    { "id": "scatter",    "type": "EmbeddingScatter", "position": { "x":  600, "y": 240 }, "data": { "params": { "method": "PCA", "perplexity": 5.0, "seed": 42 } } },
    { "id": "print_top",  "type": "Print",            "position": { "x":  900, "y": -60 }, "data": { "params": { "label": "Top-3 per sentence (rank 1 is itself)" } } }
  ],
