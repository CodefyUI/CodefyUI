      "data": {
        "params": {
          "code": "def run(inputs, params):\n    # Passes the two fresh models through unchanged. Its third input is the\n    # second checkpoint's path, so the loaders after it run only once both\n    # files are written. Comparing checkpoints from earlier runs needs no\n    # gate: wire the models straight into the loaders.\n    return {\"out1\": inputs[\"in1\"], \"out2\": inputs[\"in2\"]}\n",
          "input_ports": 3,
          "output_ports": 2,
          "input_types": "MODEL,MODEL,STRING",
          "output_types": "MODEL,MODEL"
        }
      }
