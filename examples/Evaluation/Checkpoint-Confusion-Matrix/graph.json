      "id": "confusion",
      "type": "PythonScript",
      "position": {
        "x": 3600,
        "y": 260
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # Rows are the true digit, columns the predicted one.\n    predicted = inputs[\"in1\"].argmax(dim=1)\n    truth = torch.tensor([int(v) for v in inputs[\"in2\"]], device=device)\n    matrix = torch.zeros(10, 10, dtype=torch.long, device=device)\n    for t, p in zip(truth.tolist(), predicted.tolist()):\n        matrix[t, p] += 1\n    per_class = matrix.diag().float() / matrix.sum(dim=1).float()\n    off = matrix.clone()\n    off.fill_diagonal_(0)\n    worst = int(off.argmax())\n    t, p = divmod(worst, 10)\n    lines = [f\"accuracy {matrix.diag().sum().item() / matrix.sum().item():.3f}\",\n             f\"weakest digit {int(per_class.argmin())} at {per_class.min().item():.3f}\",\n             f\"most common mistake: {t} read as {p}, {int(off[t, p])} times\"]\n    return {\"out1\": matrix.float(), \"out2\": per_class, \"out3\": \"; \".join(lines)}\n",
          "input_ports": 2,
          "output_ports": 3,
          "input_types": "TENSOR,LIST",
          "output_types": "TENSOR,TENSOR,STRING"
        }
      }
    },
