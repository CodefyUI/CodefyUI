      "data": {
        "params": {
          "code": "import statistics\n\ndef run(inputs, params):\n    # Mean and sample standard deviation of the five test accuracies.\n    scores = [float(inputs[f\"in{i}\"]) for i in range(1, 6)]\n    mean = statistics.mean(scores)\n    std = statistics.stdev(scores)\n    report = (f\"accuracy {mean:.3f} +/- {std:.3f} over {len(scores)} runs; \"\n              f\"range {min(scores):.3f} to {max(scores):.3f}\")\n    return {\"out1\": mean, \"out2\": std, \"out3\": report}\n",
          "input_ports": 5,
          "output_ports": 3,
          "input_types": "SCALAR,SCALAR,SCALAR,SCALAR,SCALAR",
          "output_types": "SCALAR,SCALAR,STRING"
        }
      }
    },
