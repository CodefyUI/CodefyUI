        }
      }
    },
    {
      "id": "hidden-trained",
      "type": "PythonScript",
      "position": {
        "x": 2520,
        "y": 260
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # The 8 hidden units the classifier head reads, for every test image:\n    # every layer of the model except the last Linear.\n    model = inputs[\"in1\"]\n    x = inputs[\"in2\"]\n    layers = list(model.layers.children()) if hasattr(model, \"layers\") else list(model.children())\n    body = torch.nn.Sequential(*layers[:-1])\n    model.eval()\n    with torch.no_grad():\n        hidden = body(x)\n    return {\"out1\": hidden}\n",
          "input_ports": 2,
          "output_ports": 1,
          "input_types": "MODEL,TENSOR",
          "output_types": "TENSOR"
        }
      }
    },
