    {
      "id": "sep-raw",
      "type": "PythonScript",
      "position": {
        "x": 3591,
        "y": 1690
      },
      "data": {
        "params": {
          "code": "import torch\n\ndef run(inputs, params):\n    # How well the 2D points keep the digits apart: the share of points whose\n    # nearest other point (in 2D) has the same label.\n    points = inputs[\"in1\"]\n    labels = list(inputs[\"in2\"])\n    distance = torch.cdist(points, points)\n    distance.fill_diagonal_(float(\"inf\"))\n    nearest = distance.argmin(dim=1).tolist()\n    same = sum(labels[i] == labels[j] for i, j in enumerate(nearest)) / len(labels)\n    return {\"out1\": round(same, 3)}\n",
          "input_ports": 2,
          "output_ports": 1,
          "input_types": "TENSOR,LIST",
          "output_types": "SCALAR"
        }
      }
    },
    {
      "id": "print-raw",
      "type": "Print",
      "position": {
