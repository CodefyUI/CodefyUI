      "data": {
        "params": {
          "code": "import math\nimport torch\n\ndef run(inputs, params):\n    # Loss against learning rate. The rate grew by the same factor every\n    # epoch, so the x axis of the plot is a log scale. Past the point where\n    # the loss is four times its minimum the run has diverged: cut it there.\n    losses = [float(v) for v in inputs[\"in1\"]]\n    lrs = list(inputs[\"in2\"][\"lr_history\"])[:len(losses)]\n    best = min(range(len(losses)), key=lambda i: losses[i])\n    end = len(losses)\n    for i in range(best, len(losses)):\n        if not math.isfinite(losses[i]) or losses[i] > 4 * losses[best]:\n            end = i\n            break\n    # Rule of thumb: a tenth of the rate at the lowest loss.\n    suggested = lrs[best] / 10\n    report = f\"lowest loss {losses[best]:.3f} at lr {lrs[best]:.3g}\"\n    if end < len(losses):\n        report += f\"; diverged by lr {lrs[end]:.3g}\"\n    report += f\"; suggested lr {suggested:.2g}\"\n    return {\"out1\": torch.tensor(losses[:end]), \"out2\": suggested, \"out3\": report}\n",
          "input_ports": 2,
          "output_ports": 3,
          "input_types": "TENSOR,ANY",
          "output_types": "TENSOR,SCALAR,STRING"
        }
      }
    },
