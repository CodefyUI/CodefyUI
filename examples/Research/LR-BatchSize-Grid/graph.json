      "data": {
        "params": {
          "code": "def run(inputs, params):\n    # One line per cell of the grid, best first.\n    cells = [(\"lr 0.001, batch 8\", inputs[\"in1\"]), (\"lr 0.001, batch 32\", inputs[\"in2\"]),\n             (\"lr 0.05, batch 8\", inputs[\"in3\"]), (\"lr 0.05, batch 32\", inputs[\"in4\"])]\n    cells.sort(key=lambda c: -float(c[1]))\n    return {\"out1\": \"; \".join(f\"{name}: {float(acc):.3f}\" for name, acc in cells)}\n",
          "input_ports": 4,
          "output_ports": 1,
          "input_types": "SCALAR,SCALAR,SCALAR,SCALAR",
          "output_types": "STRING"
        }
      }
    },
