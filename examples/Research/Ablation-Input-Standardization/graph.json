        "params": {
          "code": "def run(inputs, params):\n    # The same flowers, with petal width recorded in micrometres instead of\n    # centimetres: one column is now ten thousand times larger than the rest.\n    train = inputs[\"in1\"].clone()\n    test = inputs[\"in2\"].clone()\n    train[:, 3] *= 10000\n    test[:, 3] *= 10000\n    return {\"out1\": train, \"out2\": test}\n",
          "input_ports": 2,
          "output_ports": 2,
          "input_types": "TENSOR,TENSOR",
          "output_types": "TENSOR,TENSOR"
        }
      }
    },
